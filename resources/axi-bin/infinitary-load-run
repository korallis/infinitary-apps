#!/bin/bash
# The native half of infinitary-load-axi. No program or environment crosses
# the task channel: the admitted group execs the caller's original argv here.
# Bash's job-control group works without a terminal on macOS and Linux.

# The receipt worker never creates the payload. Its supervisor cancels it when
# that payload finishes, including a pending request or cadence wait; on
# Windows, which has no supervisor, it ends itself with its wrapper.
if [ "${1:-}" = _receipt ]; then
  hold=$2; leader=$3; payload=$4
  launcher=${0%/*}/infinitary-load-axi
  request=
  watcher=
  answerFile=
  canceled=
  finish_receipt() {
    trap '' TERM INT HUP
    if [ -n "$request" ]; then kill "$request" 2>/dev/null; wait "$request" 2>/dev/null; fi
    if [ -n "$watcher" ]; then kill "$watcher" 2>/dev/null; wait "$watcher" 2>/dev/null; fi
    [ -z "$answerFile" ] || rm -f "$answerFile"
    exit 0
  }
  cancel_receipt() {
    canceled=1
    [ "$request" = starting ] || finish_receipt
  }
  trap cancel_receipt TERM INT HUP
  trap finish_receipt EXIT
  answerFile=$(mktemp) || exit 1
  # A wait that the supervisor's cancellation ends at once.
  pause() {
    request=starting
    sleep "$1" & request=$!
    [ -z "$canceled" ] || finish_receipt
    wait "$request"; request=
  }
  birth=
  wrapper=
  if [ -r "/proc/$$/winpid" ]; then
    # Windows: the wrapper runs the payload as its foreground child and cannot
    # name it, so the last argument is the wrapper's own Git Bash number and
    # the payload is its child. A shell builtin has no process and gets no
    # receipt; the scans end so that one never polls for a whole run.
    wrapper=$payload; payload=; scans=0
    # A wrapper stopped by force cancels nothing, and the program may outlive
    # it, so this worker ends within a second of its wrapper whatever it waits
    # for. Git Bash gives an ended program's number to a later one: the
    # wrapper is alive only while its number still reads its Windows number,
    # and only this worker's own child signals it.
    (
      nap=
      trap 'kill "$nap" 2>/dev/null; exit 0' TERM
      mine() { read -r up < "/proc/$BASHPID/ppid" && [ "$up" = "$$" ]; }
      while mine && read -r now < "/proc/$wrapper/winpid" && [ "$now" = "$leader" ]; do
        sleep 1 & nap=$!
        wait "$nap"
      done
      mine && kill -TERM "$$"
    ) &
    watcher=$!
    # Git Bash starts a program as a copy of this wrapper, under a Windows
    # number the program then leaves: only a child that already shows
    # arguments of its own carries the program's number. The copy shows the
    # wrapper's whole list, which a program cannot: its own list is only that
    # list's end, so its arguments may hold any words of the wrapper's.
    mapfile -d '' -t own < "/proc/$wrapper/cmdline" || exit 0
    while :; do
      for entry in /proc/[0-9]*; do
        read -r parent < "$entry/ppid" || continue
        [ "$parent" = "$wrapper" ] || continue
        mapfile -d '' -t line < "$entry/cmdline" || continue
        [ "${#line[@]}" -gt 0 ] || continue
        if [ "${#line[@]}" -eq "${#own[@]}" ]; then
          copy=1
          for part in "${!own[@]}"; do
            [ "${line[part]}" = "${own[part]}" ] || { copy=; break; }
          done
          [ -z "$copy" ] || continue
        fi
        payload=${entry#/proc/}; break
      done
      [ -z "$payload" ] || break
      scans=$((scans + 1))
      [ "$scans" -lt 30 ] || exit 0
      pause 1
    done
  elif [ -r "/proc/$payload/stat" ]; then
    IFS= read -r stat < "/proc/$payload/stat"
    stat=${stat##*)}
    set -f
    fields=($stat)
    if [ -n "${fields[19]:-}" ]; then birth=linux:${fields[19]}; fi
  else
    birth=$(LC_ALL=C TZ=UTC /bin/ps -p "$payload" -o lstart= 2>/dev/null)
    birth="${birth#"${birth%%[![:space:]]*}"}"
    birth="${birth%"${birth##*[![:space:]]}"}"
    [ -z "$birth" ] || birth=utc:$birth
  fi
  [ -n "$birth" ] || [ -n "$wrapper" ] || exit 0
  refusals=0
  while kill -0 "$payload" 2>/dev/null; do
    identity=(--payload "$payload" --started "$birth")
    if [ -n "$wrapper" ]; then
      # Git Bash cannot read Windows' birth stamp: the app stamps this number
      # from its own reading of the run's job.
      read -r number < "/proc/$payload/winpid" || exit 0
      identity=(--payload "$number")
    fi
    request=starting
    INFINITARY_SHELL_CAP_MS= FM3000_SHELL_CAP_MS= INFINITARY_SHELL_ID= \
      /bin/sh "$launcher" receipt --hold "$hold" --pid "$leader" "${identity[@]}" >"$answerFile" 2>&1 &
    request=$!
    [ -z "$canceled" ] || finish_receipt
    wait "$request"
    code=$?
    request=
    [ "$code" -ne 0 ] || exit 0
    failure=; delay=
    while IFS=' ' read -r key value; do
      case $key in code:) failure=$value ;; retrySeconds:) delay=$value ;; esac
    done < "$answerFile"
    if [ "$failure" != RECEIPT_UNAVAILABLE ]; then
      [ -n "$wrapper" ] || exit 0
      # Git Bash starts a program in one Windows process and the program then
      # takes another, so the refused number may be the process that is gone.
      # Only a new number asks again, and a program that keeps replacing
      # itself stops being asked about.
      refusals=$((refusals + 1))
      [ "$refusals" -lt 5 ] || exit 0
      read -r next < "/proc/$payload/winpid" || exit 0
      [ "$next" != "$number" ] || exit 0
      continue
    fi
    if [ -n "$delay" ]; then
      case $delay in *[!0-9]*|0) exit 0 ;; esac
      pause "$delay"
    fi
  done
  exit 0
fi

invalid() {
  printf 'error: %s\ncode: VALIDATION_ERROR\n' "$1" >&2
  exit 2
}
usage() {
  printf 'infinitary-load-axi run --processors <number> --memory-mib <number> -- <program> [arguments]\n'
  printf 'Declare the whole run’s needs. It waits in this computer’s line, then runs unchanged.\n'
}

group=
if [ "${1:-}" = _group ]; then group=1; shift; fi
[ "${1:-}" = run ] || invalid 'Use run before the resource declarations.'
shift
cpu=
memory=
separator=
while [ "$#" -gt 0 ]; do
  case $1 in
    --help|-h) usage; exit 0 ;;
    --processors)
      [ "$#" -ge 2 ] && [ -z "$cpu" ] || invalid 'Name processors once, with a value.'
      cpu=$2; shift 2 ;;
    --memory-mib)
      [ "$#" -ge 2 ] && [ -z "$memory" ] || invalid 'Name memory once, in MiB.'
      memory=$2; shift 2 ;;
    --) separator=1; shift; break ;;
    *) invalid 'Name processors and memory, then -- and the program.' ;;
  esac
done
[ -n "$cpu" ] && [ -n "$memory" ] && [ -n "$separator" ] && [ "$#" -gt 0 ] || invalid 'Name processors, memory and the program after --.'

# A nested wrapper stays in the already admitted group. The app checks its
# identity and refuses a demand larger than the outer declaration.
if [ -z "$group" ] && [ -z "${INFINITARY_LOAD_HOLD:-}" ]; then
  set -m
  /bin/bash "$0" _group run --processors "$cpu" --memory-mib "$memory" -- "$@" <&0 &
  child=$!
  set +m
  trap 'kill -INT -- -"$child" 2>/dev/null' INT
  trap 'kill -TERM -- -"$child" 2>/dev/null' TERM
  trap 'kill -HUP -- -"$child" 2>/dev/null' HUP
  while :; do
    wait "$child"
    code=$?
    kill -0 "$child" 2>/dev/null || exit "$code"
  done
fi

launcher=${0%/*}/infinitary-load-axi
# Git Bash numbers its programs itself; the app reads Windows' own number, and
# makes this program lead a Windows job in place of the group above.
# Windows also reads no parent for this program, so it names its caller: the
# wrapper that started it, whose end takes a waiting run out of the line.
self=$$
windows=
caller=()
if [ -r "/proc/$$/winpid" ]; then
  read -r self < "/proc/$$/winpid"
  windows=1
  if [ -n "$group" ] && [ -r "/proc/$PPID/winpid" ]; then
    read -r outer < "/proc/$PPID/winpid"
    caller=(--caller "$outer")
  fi
fi
last=
retryDelay=
while :; do
  parent=()
  if [ -n "${INFINITARY_LOAD_HOLD:-}" ]; then parent=(--parent "$INFINITARY_LOAD_HOLD"); fi
  # The wrapper itself is the waiting job. Each short request must return its
  # own answer rather than park one for an unrelated command in this task.
  # /bin/sh starts the launcher rather than its path: macOS 26 keeps a 1 KB
  # kernel buffer each time a script starts another script by path.
  answer=$(INFINITARY_SHELL_CAP_MS= FM3000_SHELL_CAP_MS= INFINITARY_SHELL_ID= \
    /bin/sh "$launcher" claim --pid "$self" --processors "$cpu" --memory-mib "$memory" "${parent[@]}" "${caller[@]}" 2>&1)
  code=$?
  state=
  hold=
  delay=
  failure=
  # The room the first in line waits for changes with every reading; only the
  # rest of the answer decides whether the crewmate is shown it again.
  shown=
  while IFS=' ' read -r key value; do
    case $key in free: | processors: | memoryMiB:) ;; *) shown+="$key $value"$'\n' ;; esac
    case $key in
      state:) state=$value ;;
      hold:) hold=$value ;;
      retrySeconds:) delay=$value ;;
      code:) failure=$value ;;
    esac
  done <<< "$answer"
  if [ "$code" -ne 0 ]; then
    # Only the claim's typed interruption is recoverable. Keep this group and
    # its declaration; a late host reply cannot launch the payload from here.
    if [ "$failure" != CLAIM_UNAVAILABLE ]; then printf '%s\n' "$answer" >&2; exit "$code"; fi
    if [ "$shown" != "$last" ]; then printf '%s\n' "$answer" >&2; last=$shown; fi
    if [ -n "$delay" ]; then retryDelay=$delay; fi
    # A first transport timeout has already waited out curl's bound and may
    # not yet have received the app's cadence. Later polls reuse that cadence.
    if [ -n "$retryDelay" ]; then
      case $retryDelay in *[!0-9]*|0) invalid 'The app answered without its reading cadence.' ;; esac
      sleep "$retryDelay"
    fi
    continue
  fi
  case $state in
    running)
      [ -n "$hold" ] || invalid 'The app answered without the run’s hold.'
      if [ -n "${INFINITARY_LOAD_HOLD:-}" ]; then exec -- "$@"; fi
      export INFINITARY_LOAD_HOLD=$hold
      # Windows has no native supervisor: the program runs in this job as this
      # leader's foreground child, keeping its input, signals and status. Git
      # Bash's exec of one of its own programs would end this Windows process,
      # which the app reads as the run's end, so the leader waits and answers
      # with the program's status. The receipt worker holds none of the
      # caller's streams and starts from a subshell that ends at once, so it
      # is no job of this shell: a builtin runs in this shell, and its wait,
      # kill and $! must meet only jobs it started itself. Nothing here
      # signals the worker either, which ends itself with this leader.
      if [ -n "$windows" ]; then
        ( /bin/bash "$0" _receipt "$hold" "$self" "$$" </dev/null >/dev/null 2>&1 & )
        "$@"
        exit $?
      fi
      supervisor=${0%/*}/../load-bin/infinitary-load-supervisor
      [ -x "$supervisor" ] || supervisor=${0%/*}/../../vendor/load-bin/infinitary-load-supervisor
      [ -x "$supervisor" ] || invalid 'The native run supervisor is missing; nothing started.'
      exec "$supervisor" "$0" "$hold" "$@"
      ;;
    waiting)
      if [ "$shown" != "$last" ]; then printf '%s\n' "$answer" >&2; last=$shown; fi
      case $delay in ''|*[!0-9]*|0) invalid 'The app answered without its reading cadence.' ;; esac
      retryDelay=$delay
      sleep "$delay"
      ;;
    *) invalid 'The app did not answer admission; nothing started.' ;;
  esac
done
